ErrorDocument 404 /404.html

# Every navigation revalidates the site files before reusing them.  This keeps
# new tabs on the latest deployment while preserving the desktop's client-side
# sessionStorage state across refreshes.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-cache, must-revalidate"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
</IfModule>
