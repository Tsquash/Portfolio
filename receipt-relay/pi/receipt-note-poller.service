[Unit]
Description=Portfolio receipt-note poller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_PI_USERNAME
WorkingDirectory=REPLACE_WITH_DIRECTORY_CONTAINING_NOTE_PY
EnvironmentFile=/etc/portfolio-receipt-poller.env
ExecStart=/usr/bin/python3 RECEIPT_NOTE_POLLER_PATH
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
